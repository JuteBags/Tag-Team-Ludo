{
  "name": "tag-team-ludo-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "npm --prefix .. run build && wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.wrangler/smoke.mjs && node .wrangler/smoke.mjs",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
