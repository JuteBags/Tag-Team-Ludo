{
  "name": "tag-team-ludo-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Tag Team Ludo for Windows: the web build in a desktop window",
  "author": "JuteBags",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.jutebags.ludo",
    "productName": "Tag Team Ludo",
    "files": [
      "main.js",
      "web/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "tag-team-ludo-windows.exe"
    }
  }
}
